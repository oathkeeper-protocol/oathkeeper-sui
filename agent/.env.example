# --- Sui RPC ---
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_WS_URL=wss://fullnode.testnet.sui.io:443

# --- Oathkeeper package address (set after `sui client publish`) ---
OATHKEEPER_PACKAGE_ID=0x0
OATHKEEPER_REGISTRY_ID=0x0
OATHKEEPER_LP_POOL_USDC_ID=0x0

# --- Demo wallets (testnet only — never commit real keys) ---
OATHKEEPER_PROMISER_KEY=suiprivkey1...
OATHKEEPER_DOUBTER_KEY=suiprivkey1...
OATHKEEPER_LP_KEY=suiprivkey1...
OATHKEEPER_EXEC_KEY=suiprivkey1...

# --- Walrus (Week 2 Day 8-9) ---
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_EPOCHS=10
# Signer must hold both SUI (for blob registration gas) and WAL (for storage cost).

# --- Seal (Week 2 Day 11; SDK package name TBD) ---
SEAL_KEY_SERVERS=server1,server2,server3
SEAL_THRESHOLD=2

# --- DeepBook V3 (Week 3 Day 15) ---
DEEPBOOK_PACKAGE_ID=0x22be4cade64bf2d02412c7e8d0e8beea2f78828b948118d46735315409371a3c
DEEPBOOK_REGISTRY_ID=0x7c256edbda983a2cd6f946655f4bf3f00a41043993781f8674a7046e8c0e11d1
DEEP_TREASURY_ID=0x69fffdae0075f8f71f4fa793549c11079266910e8905169845af1f5d00e09dcb
DEEP_TYPE=0x36dbef866a1d62bf7328989a10fb2f07d769f4ee587c0de4a0a256e57e0a58a8::deep::DEEP
DBUSDC_TYPE=0xf7152c05930480cd740d7311b5b8b45c6f488e3a53a11c3f74a6fac36a52e0d7::DBUSDC::DBUSDC
DEEP_SUI_POOL_ID=0x48c95963e9eac37a316b7ae04a0deb761bcdcc2b67912374d6036e7f0e9bae9f
SUI_DBUSDC_POOL_ID=0x1c19362ca52b8ffd7a33cee805a67d40f31e6ba303753fd3a4cfdfacea7163a5
DEEPBOOK_BALANCE_MANAGER_ID=0x0
DEEPBOOK_TRADE_CAP_ID=0x0
DEEPBOOK_DEPOSIT_CAP_ID=0x0
DEEPBOOK_WITHDRAW_CAP_ID=0x0

# --- Live witnessed DeepBook harness ---
# Run:
#   pnpm live:witnessed bootstrap-manager
#   pnpm live:witnessed full
LIVE_WITNESSED_EPOCH_MS=60000
LIVE_WITNESSED_BOND=1000
LIVE_WITNESSED_CLIENT_CLAIM=500
LIVE_WITNESSED_BASE_IN=1
LIVE_WITNESSED_MIN_QUOTE_OUT=1
LIVE_WITNESSED_INITIAL_QUOTE_DEPOSIT=0
LIVE_WITNESSED_ALLOWED_ASSETS=SUI,DBUSDC

# --- Hyperliquid (Week 3 Day 16, optional) ---
HL_API_URL=https://api.hyperliquid-testnet.xyz
HL_EXEC_EVM_KEY=0x...

# --- Uptime prober (Week 3 Day 17) ---
PROBER_TARGET_URL=https://example.com
PROBER_INTERVAL_MS=60000
PROBER_ED25519_KEY=...

# --- Logging ---
LOG_LEVEL=info
