{
  "name": "oathkeeper-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain runtime for Oathkeeper-Sui: Walrus + Seal pipeline, DeepBook agent runner, reconciliation indexer, HTTPS uptime prober.",
  "type": "module",
  "scripts": {
    "reconcile": "tsx src/recon/cli.ts",
    "recon:demo": "tsx src/recon/demo.ts",
    "verify": "tsx src/recon/verify.ts",
    "walrus:store": "tsx src/walrus/cli.ts store",
    "walrus:read": "tsx src/walrus/cli.ts read",
    "walrus:demo": "tsx src/walrus/cli.ts demo",
    "indexer": "tsx watch src/indexer/index.ts",
    "indexer:once": "tsx src/indexer/index.ts",
    "runner": "tsx watch src/runner/index.ts",
    "prober": "tsx watch src/prober/index.ts",
    "live:witnessed": "tsx src/sui/live-witnessed-swap.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@mysten/sui": "^2.17.0",
    "@mysten/walrus": "^1.1.7",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
